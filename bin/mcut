#!/usr/bin/env bash
# Run the mcut CLI from this checkout. Installs uv on first use; the Python
# environment lives outside the checkout so plugin updates don't rebuild it.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$HOME/.local/bin:$PATH"
if ! command -v uv >/dev/null 2>&1; then
  echo "mcut: installing uv (https://docs.astral.sh/uv/) ..." >&2
  curl -LsSf https://astral.sh/uv/install.sh | sh >&2
fi
export PYTHONWARNINGS="ignore::SyntaxWarning"
export UV_PROJECT_ENVIRONMENT="${MCUT_VENV:-$HOME/.cache/mcut/venv}"
exec uv run --quiet --frozen --project "$ROOT" mcut "$@"
